{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".output/public",
    "cleanUrls": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/version",
        "destination": "/version.json"
      },
      {
        "source": "!/version.json",
        "destination": "/index.html"
      }
    ]
  }
}
