# Firebase Web SDK configuration (public client configuration; not a secret)
NUXT_PUBLIC_FIREBASE_API_KEY=replace-me
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-me
NUXT_PUBLIC_FIREBASE_PROJECT_ID=replace-me
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=replace-me
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-me
NUXT_PUBLIC_FIREBASE_APP_ID=replace-me

# Supabase Storage client configuration (publishable key only; never use service_role here)
NUXT_PUBLIC_SUPABASE_URL=https://replace-me.supabase.co
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-me

# Never place Firebase service account/private keys or Supabase service_role keys in this file.
